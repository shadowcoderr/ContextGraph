{
  "name": "@shadowcoderr/context-graph",
  "version": "0.4.0",
  "description": "A deterministic 'Flight Data Recorder' for web applications that transforms manual exploration into structured, AI-ready intelligence.",
  "main": "dist/cli/index.js",
  "bin": {
    "context-graph": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "ts-node src/cli/index.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest",
    "test:e2e": "npx playwright test",
    "test:all": "jest && npx playwright test",
    "test:watch": "jest --watch",
    "clean": "rimraf dist"
  },
  "keywords": [
    "web-capture",
    "playwright",
    "automation",
    "testing",
    "ai",
    "cli"
  ],
  "author": "shadowcoderr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadowcoderr/ContextGraph.git"
  },
  "bugs": {
    "url": "https://github.com/shadowcoderr/ContextGraph/issues"
  },
  "homepage": "https://github.com/shadowcoderr/ContextGraph#readme",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.4",
    "help": "^3.0.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "inquirer": "^13.4.2",
    "jest": "^30.3.0",
    "ora": "^9.4.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
